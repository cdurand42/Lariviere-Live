# ==============================================================================
# Larivière Live — Secrets d'accès & Déploiement (.streamlit/secrets.toml)
# NE JAMAIS COMMETTRE CE FICHIER AVEC DE VRAIES VALEURS DANS GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credentials d'accès au sas d'authentification
# ------------------------------------------------------------------------------
LIVE_USERNAME = "admin"
# Empreinte PBKDF2-HMAC-SHA256 (générer via 'python auth.py')
LIVE_PASSWORD_HASH = "pbkdf2_sha256$600000$0123456789abcdef0123456789abcdef$0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 2. Accès GitHub sécurisé au dépôt privé LariviereAI
# PAT fine-grained read-only avec accès limité au repo cdurand42/lariviere-ai-demo
# Permissions requises : Repository permissions -> Contents : Read-only
# ------------------------------------------------------------------------------
GITHUB_TOKEN = "github_pat_votre_token_fine_grained_ici"
GITHUB_REPO = "cdurand42/lariviere-ai-demo"
GITHUB_REF = "feat/streamlit-auth-gateway"

# ------------------------------------------------------------------------------
# 3. Clés de service et modèles Larivière
# ------------------------------------------------------------------------------
GEMINI_API_KEY = "votre_cle_gemini_api"
DEFAULT_GOOGLE_STRATEGIC_MODEL = "gemini-3.8-flash"
DEFAULT_GOOGLE_FAST_MODEL = "gemini-3.6-flash"

# Optionnels
CLOUDFLARE_ACCOUNT_ID = ""
CLOUDFLARE_API_TOKEN = ""
TAVILY_API_KEY = ""
SUPABASE_URL = ""
SUPABASE_KEY = ""
SUPABASE_BUCKET = ""
USAGE_MONITOR_URL = ""
USAGE_MONITOR_INGEST_TOKEN = ""
USAGE_MONITOR_ENABLED = "true"
